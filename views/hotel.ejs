<%- include('./partials/header') %>

  <div class="bg-neutral-200 w-full h-screen flex px-10 py-10 overflow-hidden">

    <%- include('./partials/sidemenu') %>

      <div class="p-4 sticky bg-gray-800 h-auto mb-[2rem] pb-[2rem] rounded-lg mt-10 sm:ml-64 w-full">
        <div class="border-2 border-gray-200 rounded-lg h-full dark:border-gray-700 mt-4 flex flex-col">
          <div class="sticky top-0 z-10 bg-gray-800 px-6 flex justify-between items-center rounded-t-lg">
            <h2 class="text-3xl font-bold text-white top-[2rem] mt-4 ml-[9.5rem] mb-4">Reserve Your Hotel: <span
                class="text-blue-400"><%- trip.name%></span></h2>
            <div class="relative flex items-center">
              <form method="GET">
                <input class="bg-gray-700 w-[15vw] text-gray-200 border-2 border-gray-500 rounded-md p-2 pl-10 m-4"
                  type="search" name="q" id="search" placeholder="Search hotels"
                  value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
              </form>
              <!-- <input class="bg-gray-700 w-[15vw] text-gray-200 border-0 rounded-md p-2 pl-10 m-4" type="search" name="search" id="search" placeholder="Search hotels"> -->
              <svg
                class="absolute left-6 top-1/2 transform -translate-y-1/2 shrink-0 w-5 h-5 text-gray-500 transition duration-75 dark:text-gray-500 group-hover:text-white dark:group-hover:text-white"
                aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 512 512">
                <path
                  d="M416 208c0 45.9-14.9 88.3-40 122.7L502.6 457.4c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L330.7 376c-34.4 25.2-76.8 40-122.7 40C93.1 416 0 322.9 0 208S93.1 0 208 0S416 93.1 416 208zM208 352a144 144 0 1 0 0-288 144 144 0 1 0 0 288z" />
              </svg>
            </div>
          </div>
          <div class="overflow-y-auto max-h-[75vh] px-6 pt-4 mb-4">

            <% hotels.forEach(function(hotel){ %>
              <div
                class="relative mx-auto mb-5 w-4/5 h-[200px] bg-slate-200/80 border-2 border border-grey-200 rounded-lg hover:border-blue-500 hover:border-2">
                <div class="absolute top-[22px] left-[409px] font-bold text-2xl text-gray-800">
                  <%= hotel.name %>
                </div>

                <div class="absolute top-[56px] left-[410px]">
                  <svg width="200" height="1" viewBox="0 0 200 1" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0 0.5H200" stroke="#6e7b91" />
                  </svg>
                </div>

                <div class="absolute top-[65px] left-[409px] flex flex-col items-center justify-center space-y-2">
                  <% if (hotel.discount> 0) { %>
                    <div
                      class="leading-[18px] bg-[#636ae8] text-white font-sans text-xs font-medium font-semibold px-2.5 py-0.5 rounded-md">
                      <%= hotel.discount %>% Off
                    </div>
                    <% } else { %>
                      <div
                        class="leading-[18px] bg-red-600 text-white text-xs font-medium font-semibold px-2.5 py-0.5 rounded-md">
                        Exclusive
                      </div>
                      <% } %>
                        </div>
                        <div class="absolute top-[95px] left-[410px] flex space-x-1">
                          <% for (let i=0; i < 5; i++) { %>
                            <svg width="19" height="19" viewBox="0 0 18 17" fill="none"
                              xmlns="http://www.w3.org/2000/svg">
                              <path
                                d="M7.49114 1.96686C7.67947 1.51405 8.32094 1.51406 8.50927 1.96687L10.0583 5.69126C10.1377 5.88215 10.3173 6.01258 10.5233 6.02911L14.5441 6.35145C15.033 6.39064 15.2312 7.00069 14.8587 7.31971L11.7953 9.94391C11.6383 10.0784 11.5697 10.2894 11.6177 10.4905L12.5537 14.4141C12.6675 14.8912 12.1485 15.2682 11.73 15.0126L8.2876 12.91C8.1112 12.8022 7.88927 12.8022 7.71287 12.91L4.27047 15.0126C3.85196 15.2682 3.33301 14.8912 3.4468 14.4141L4.38272 10.4905C4.4307 10.2894 4.36212 10.0784 4.20511 9.94391L1.14168 7.31971C0.769236 7.00069 0.967456 6.39064 1.4563 6.35145L5.4771 6.02911C5.68318 6.01258 5.8627 5.88215 5.9421 5.69126L7.49114 1.96686Z"
                                fill="<%= i < hotel.rating ? 'url(#paint0_linear_1_271)' : 'none' %>"
                                stroke="#6e7b91" />
                              <defs>
                                <linearGradient id="paint0_linear_1_271" x1="0.948242" y1="1.62726" x2="15.0522"
                                  y2="1.62726" gradientUnits="userSpaceOnUse">
                                  <stop offset="0.4999" stop-color="#636AE8" />
                                  <stop offset="0.5" stop-color="#636AE8" />
                                </linearGradient>
                              </defs>
                            </svg>
                            <% } %>
                </div>
                

                <div class="absolute flex-col font-semibold text-sm text-gray-800 top-[120px] left-[410px] space-y-1">
                  <div class="flex items-center space-x-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor"
                      viewBox="0 0 256 512">
                      <path
                        d="M246.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-128-128c-9.2-9.2-22.9-11.9-34.9-6.9s-19.8 16.6-19.8 29.6l0 256c0 12.9 7.8 24.6 19.8 29.6s25.7 2.2 34.9-6.9l128-128z" />
                    </svg>
                    <span>
                      <%= hotel.facility1 %>
                    </span>
                  </div>
                  <div class="flex items-center space-x-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor"
                      viewBox="0 0 256 512">
                      <path
                        d="M246.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-128-128c-9.2-9.2-22.9-11.9-34.9-6.9s-19.8 16.6-19.8 29.6l0 256c0 12.9 7.8 24.6 19.8 29.6s25.7 2.2 34.9-6.9l128-128z" />
                    </svg>
                    <span>
                      <%= hotel.facility2 %>
                    </span>
                  </div>
                  <div class="flex items-center space-x-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor"
                      viewBox="0 0 256 512">
                      <path
                        d="M246.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-128-128c-9.2-9.2-22.9-11.9-34.9-6.9s-19.8 16.6-19.8 29.6l0 256c0 12.9 7.8 24.6 19.8 29.6s25.7 2.2 34.9-6.9l128-128z" />
                    </svg>
                    <span>
                      <%= hotel.facility3 %>
                    </span>
                  </div>
                </div>

                <div class="absolute top-[10px] right-0 mr-4 text-right">
                  <span class="text-xl font-bold text-gray-800">₹<%= hotel.price %>
                      <p class="text-gray-800 text-sm inline">/Night</p></span>
                </div>

                <div class="absolute top-0 left-0 m-1 w-[375px] h-[190px]">
                  <img class="absolute top-0 left-0 p-1 w-[300px] h-[185px] rounded-2xl "
                    src="data:image/jpeg;base64,<%= hotel.image.toString('base64') %>" alt="Trip Image" />
                  <img
                    class="absolute top-[3px] left-[322px] w-[50px] h-[50px] rounded-2xl border border-gray-300 transition-transform duration-300 hover:scale-[1.7]"
                    src="data:image/jpeg;base64,<%= hotel.image.toString('base64') %>" alt="Trip Image 2" />
                  <img
                    class="absolute top-[69px] left-[322px] w-[50px] h-[50px] rounded-2xl border border-gray-300 transition-transform duration-300 hover:scale-[1.7]"
                    src="data:image/jpeg;base64,<%= hotel.image.toString('base64') %>" alt="Trip Image 3" />
                  <img
                    class="absolute top-[135px] left-[322px] w-[50px] h-[50px] rounded-2xl border border-gray-300 transition-transform duration-300 hover:scale-[1.7]"
                    src="data:image/jpeg;base64,<%= hotel.image.toString('base64') %>" alt="Trip Image 4" />
                </div>
                <div
                  class="right-2 bottom-2 absolute bg-[#636ae8] rounded-md border border-black/0 justify-center items-center inline-flex overflow-hidden">
                  <a href="/shop/<%= trip._id %>/<%= hotel._id %>">
                    <button
                      class="px-3 py-2 border-2 border-white font-semibold text-white rounded-md hover:bg-indigo-800 hover:text-white focus:outline-none">Book
                      Now</button>
                  </a>
                </div>
              </div>
              <% }) %>
          </div>
        </div>
      </div>
  </div>
  <%- include('./partials/footer') %>