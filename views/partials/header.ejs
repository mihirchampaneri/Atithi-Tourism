<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>अतिथि Tourism</title>
    <link
      rel="icon"
      type="image/png"
      sizes="40x50"
      href="/img/icon-plan.png"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="font-['helvetica_now_display']">
    <nav
      class="fixed w-full flex top-0 z-[1] justify-between bg-white px-5 py-3"
    >
      <h3
        class="text-blue-500 font-semibold text-3xl justify-center items-center"
      >
        अतिथि Tourism
      </h3>
      <% var loggedin = typeof loggedin !== "undefined" ? loggedin : true %> <%
      if(loggedin) { %>
      <div class="justify-center items-center flex gap-5">
        <div class="relative flex justify-between gap-2">
          <button
            id="userToggle"
            class="group flex items-center justify-start w-10 h-10 bg-blue-500/30 rounded-full cursor-pointer relative overflow-hidden transition-all duration-300 shadow-lg hover:w-40 hover:rounded-full active:translate-x-1 active:translate-y-1"
          >
            <div
              class="flex items-center font-black font-sans text-xl text-blue-500 justify-center w-full transition-all duration-300 group-hover:justify-start group-hover:opacity-0 group-hover:px-3"
            >
              <%= user.fullname.charAt(0).toUpperCase() %>
            </div>
        
            <div
              class="absolute whitespace-nowrap left-1/2 top-1/2 transform -translate-x-1/2 -translate-y-1/2 font-sans font-semibold opacity-0 text-blue-500 text-lg transition-all duration-500 group-hover:opacity-100"
            >
              <%= user.fullname %>
            </div>
          </button>
          <% if (userRole === 'User') { %>
          <div
            id="userMenu"
            class="absolute top-full mt-2 -left-16 w-40 bg-white border border-gray-200 rounded-md shadow-md opacity-0 pointer-events-none transition-all duration-300 z-50"
          >
            <ul class="text-sm text-gray-700">
              <li><a href="/users/myaccount" class="block px-4 py-2 hover:bg-gray-100">Change Password</a></li>
              <li><a href="/bookings/mybooking" class="block px-4 py-2 hover:bg-gray-100">My Bookings</a></li>
              <li><p class="block px-4 py-2 text-gray-500 text-center cursor-none"><%= userRole %></p></li>
            </ul>
          </div>
        </div>
        <% } %>

        <script>
          const toggleBtn = document.getElementById('userToggle');
          const userMenu = document.getElementById('userMenu');
        
          toggleBtn.addEventListener('click', (e) => {
            e.stopPropagation(); // prevent click bubbling
            userMenu.classList.toggle('opacity-0');
            userMenu.classList.toggle('pointer-events-none');
          });
        
          document.addEventListener('click', (e) => {
            if (!userMenu.classList.contains('opacity-0')) {
              userMenu.classList.add('opacity-0');
              userMenu.classList.add('pointer-events-none');
            }
          });
        </script>
        
        

        <a href="/users/logout">
          <button
            class="group flex items-center justify-start w-9 h-9 bg-red-600 rounded-full cursor-pointer relative overflow-hidden transition-all duration-200 shadow-lg hover:w-32 hover:rounded-full active:translate-x-1 active:translate-y-1"
          >
            <div
              class="flex items-center justify-center w-full transition-all duration-300 group-hover:justify-start group-hover:px-3"
            >
              <svg class="w-4 h-4" viewBox="0 0 512 512" fill="white">
                <path
                  d="M377.9 105.9L500.7 228.7c7.2 7.2 11.3 17.1 11.3 27.3s-4.1 20.1-11.3 27.3L377.9 406.1c-6.4 6.4-15 9.9-24 9.9c-18.7 0-33.9-15.2-33.9-33.9l0-62.1-128 0c-17.7 0-32-14.3-32-32l0-64c0-17.7 14.3-32 32-32l128 0 0-62.1c0-18.7 15.2-33.9 33.9-33.9c9 0 17.6 3.6 24 9.9zM160 96L96 96c-17.7 0-32 14.3-32 32l0 256c0 17.7 14.3 32 32 32l64 0c17.7 0 32 14.3 32 32s-14.3 32-32 32l-64 0c-53 0-96-43-96-96L0 128C0 75 43 32 96 32l64 0c17.7 0 32 14.3 32 32s-14.3 32-32 32z"
                ></path>
              </svg>
            </div>
            <div
              class="absolute right-5 transform translate-x-full opacity-0 text-white text-lg transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100"
            >
              Logout
            </div>
          </button>
        </a>
      </div>
      <% } %>
    </nav>
  </body>
</html>
