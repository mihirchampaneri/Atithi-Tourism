<%- include('partials/header') %>
  <div class="bg-neutral-200 h-screen flex px-10 py-10 overflow-hidden">

    <%- include('./partials/sidemenu') %>

      <div class="p-4 bg-gray-800 h-auto rounded-lg mt-10 mb-8 sm:ml-64">
        <div class="border-2 border-line border-gray-200 rounded-lg h-full pb-6 w-[85em] dark:border-gray-700">

          <h2 class="text-3xl text-white top-[2rem] mt-4 ml-4 mb-4 font-bold ">My <span class="text-blue-400">Wishlist
            </span>:</h2>

          <% if (wishlistTrips.length> 0) { %>
            <div class="grid grid-cols-1 sm:grid-cols-1 lg:grid-cols-2 gap-4">
              <% wishlistTrips.forEach(trip=> { %>
                <div
                  class="relative mb-5 w-[95%] h-[200px] bg-white/80 ml-4 border-2 border border-grey-200 rounded-lg hover:border-indigo-500 hover:shadow-md hover:shadow-blue-500/50">
                  <div class="absolute top-[22px] left-[409px] font-bold text-2xl text-gray-800">
                    <%= trip.name %>
                  </div>

                  <div class="absolute top-[56px] left-[410px]">
                    <svg width="200" height="1" viewBox="0 0 200 1" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M0 0.5H200" stroke="#6e7b91" />
                    </svg>
                  </div>

                  <% if (trip.discount> 0) { %>
                    <div
                      class="absolute top-[65px] left-[409px] leading-[18px] bg-[#636ae8] text-white font-sans text-xs font-medium font-semibold me-2 px-2.5 py-0.5 rounded-md">
                      <%= trip.discount %>% Off
                    </div>
                    <% } else { %>
                      <div
                        class="absolute top-[65px] left-[409px] leading-[18px] bg-red-600 text-white text-xs font-medium font-semibold me-2 px-2.5 py-0.5 rounded-md">
                        New Trip
                      </div>
                      <% } %>
                        <div class="absolute flex font-semibold text-sm text-gray-800 top-[95px] left-[410px]">
                          &bull; <%= trip.facility1 %><br>
                            &bull; <%= trip.facility2 %><br>
                              &bull; <%= trip.facility3 %><br>
                        </div>


                        <div class="absolute top-6 right-8  text-right">
                          <span class="text-lg font-bold text-gray-800">₹<%= trip.price %></span>
                        </div>

                        <div class="absolute top-0 left-0 m-1 w-[375px] h-[190px]">
                          <img class="absolute top-0 left-0 p-1 w-[300px] h-[185px] rounded-2xl"
                            src="data:image/jpeg;base64,<%= trip.image.toString('base64') %>" alt="Trip Image" />
                          <img
                            class="absolute top-[3px] left-[322px] w-[50px] h-[50px] rounded-2xl border border-gray-300 transition-transform duration-300 hover:scale-[1.7]"
                            src="data:image/jpeg;base64,<%= trip.image.toString('base64') %>" alt="Trip Image 2" />
                          <img
                            class="absolute top-[69px] left-[322px] w-[50px] h-[50px] rounded-2xl border border-gray-300 transition-transform duration-300 hover:scale-[1.7]"
                            src="data:image/jpeg;base64,<%= trip.image.toString('base64') %>" alt="Trip Image 3" />
                          <img
                            class="absolute top-[135px] left-[322px] w-[50px] h-[50px] rounded-2xl border border-gray-300 transition-transform duration-300 hover:scale-[1.7]"
                            src="data:image/jpeg;base64,<%= trip.image.toString('base64') %>" alt="Trip Image 4" />
                        </div>
                        <form
                          class="right-2 bottom-2 absolute bg-red-500 rounded-md border border-black/0 justify-center items-center inline-flex overflow-hidden"
                          action="/users/wishlist/<%= trip._id %>" method="POST">
                          <button type="submit"
                            class="px-3 py-2 border-2 border-white-500 text-white rounded-md hover:bg-red-200 hover:text-blue-500 focus:outline-none">Remove</button>
                        </form>
                </div>
                <% }) %>
            </div>
            <% } else { %>
              <p class="text-lg ml-4 text-white"><br> You haven’t added any tours to your wishlist yet.</p>
              <% } %>
        </div>
      </div>
  </div>
  <%- include('partials/footer') %>